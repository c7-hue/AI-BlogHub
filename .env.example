# ===== 使用说明 =====
# 把这份文件复制一份,重命名为 .env,再修改下面的值。
# .env 已被 .gitignore 排除,不会提交到 GitHub,所以密码放这里安全。
# 服务器上必须做这一步,不做 docker compose 起不来。

# MySQL root 密码(自己设一个,建议字母+数字,别用 @ # $ 这类符号)
MYSQL_ROOT_PASSWORD=ChangeMe123456

# JWT 登录令牌的签名密钥(随手敲一长串乱字符,越乱越长越好)
JWT_SECRET=please-change-this-to-a-long-random-string

# DeepSeek AI 的 key(把你原来 backend/.env 里的值搬过来)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-v4-pro
