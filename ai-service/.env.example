# ===== 数据库(和 backend/.env 保持一致即可) =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=123456
DB_NAME=xxblog

# ===== DeepSeek(和 backend/.env 里的同一个 key) =====
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== Embedding(硅基流动 https://siliconflow.cn 注册后创建 API 密钥) =====
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ===== RAG 参数 =====
# 分块长度/重叠字数
CHUNK_SIZE=400
CHUNK_OVERLAP=50
# 检索返回条数
TOP_K=5
# 余弦相似度低于该值视为博客内无相关内容(触发"未找到相关文章"说明)
MIN_SCORE=0.35
# 服务端口(Node 后端默认调 3002)
AI_SERVICE_PORT=3002
