# ⚠️ 现役配置:fastpath 生产部署使用(fastpath/blog-deploy-kit/),与 frontend/nginx.conf(备用)不是同一份
# 服务器端组装:不做任何 npm 构建,只把本地构建好的产物装进 nginx 镜像
FROM nginx:alpine
COPY frontend-static/dist /usr/share/nginx/html
COPY frontend-static/homepage /usr/share/nginx/homepage
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
